<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget><AssemblyName>SDRSharp.Plugin.T99</AssemblyName>
    <Version>1.0.0</Version>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Description>Single-channel ARIB STD-T99 (digital low-power community radio) receiver plugin for SDR#.</Description>
    <SdkDirectory Condition="'$(SdkDirectory)'==''">$(MSBuildThisFileDirectory)../../build/sdk</SdkDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SDRSharp.Common"><HintPath>$(SdkDirectory)/SDRSharp.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SDRSharp.Radio"><HintPath>$(SdkDirectory)/SDRSharp.Radio.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SDRSharp.PanView"><HintPath>$(SdkDirectory)/SDRSharp.PanView.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- Offline map of Japan (Natural Earth 1:10m, public domain), built by tools/make-map.py -->
    <EmbeddedResource Include="japan-map.bin" LogicalName="japan-map.bin" />
  </ItemGroup>
  <Target Name="CheckSdk" BeforeTargets="ResolveReferences" Condition="!Exists('$(SdkDirectory)/SDRSharp.Common.dll')">
    <Error Text="Supply -SdrSharpExe to tools/build.ps1 (or run tools/extract-sdk.py against a local SDR# executable)." />
  </Target>
</Project>
